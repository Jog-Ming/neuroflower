#!/usr/bin/env bash
# The experimental pipeline's entry point.
#
#   ./devtools/cli versions [--no-cache]
#   ./devtools/cli decompile <version> [--no-cache] [--threads N] [--only Class]
#   ./devtools/cli tree <version> [--only Class]
#   ./devtools/cli score <version> [<version>...] [--no-cache] [--only Class] [--threads N] [--json] [--jobs N] [--since Tree]
#   ./devtools/cli diff <version> <Class> [<Class>...] [--no-cache] [--options "..."]
#   ./devtools/cli compile <version> <Class> [--no-cache] [--options "..."]
#   ./devtools/cli corpus <version> --ground-truth <dir>
#   ./devtools/cli dataset <version>
#   ./devtools/cli reports [--version V] [--limit N]
#   ./devtools/cli clean [--trees] [--compile] [--downloads] [--all]
#   ./devtools/cli cache
#
# Everything the pipeline writes lives under .dev/ and is git-ignored. Both jars are rebuilt when
# their sources are newer: the pipeline jar and the decompiler jar a decompile runs. Set
# DECOMPILER_JAR=/path/to/jar to run a specific decompiler build instead (A/B against an older jar).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
jar="$root/devtools/build/libs/devtools-all.jar"
decompiler="$root/build/libs/vineflower-1.13.0+local.jar"

# Only this jar is checked here: a shell `find` over the decompiler's source tree cost seconds on
# every call. The pipeline rebuilds that jar itself, from Java, where the same walk costs
# milliseconds (see Main.rebuildDecompilerIfStale).
rebuild=""
if [ ! -f "$jar" ] || [ -n "$(find "$root/devtools/src" "$root/devtools/build.gradle" -newer "$jar" -print -quit 2>/dev/null)" ]; then
  rebuild=1
fi
if [ -n "$rebuild" ]; then
  build_started=$SECONDS
  echo "devtools/cli: building jars" >&2
  (cd "$root" && ./gradlew :allJar :devtools:shadowJar -q)
  # Gradle decides by content hash and writes nothing when the inputs are unchanged, so a source
  # whose mtime moved without its content moving (a touch, a checkout) would leave the jar older
  # than its sources and make every later call run a no-op build. The jar is correct at this
  # point, so its timestamp is brought forward to say so.
  touch "$jar"
  [ -f "$decompiler" ] && touch "$decompiler"
  echo "devtools/cli: built in $((SECONDS - build_started))s" >&2
fi
if [ -n "${DECOMPILER_JAR:-}" ]; then
  echo "devtools/cli: decompiler $DECOMPILER_JAR" >&2
fi

if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  java_bin="$JAVA_HOME/bin/java"
elif [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java.exe" ]; then
  java_bin="$JAVA_HOME/bin/java.exe"
else
  java_bin="$(command -v java || true)"
fi
if [ -z "$java_bin" ]; then
  echo "devtools/cli: no java found" >&2
  exit 2
fi

DEVTOOLS_ROOT="$root" exec "$java_bin" -jar "$jar" "$@"
